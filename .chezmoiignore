.zshrc.d/00_distcc_ericsson_environment.zsh
.zshrc.d/00_ericsson_modules.zsh
.config/nvim/.git
.config/nvim/.gitignore
.config/nvim/.neoconf.json
.cursor/_cli-config.desired.json

# Machine-local scheduler and tooling state, not config.
# Rewrites itself on every run, and applying a stale copy on another machine
# would rewind its schedule.
.agents/.skill-lock.json

# Claude Code: runtime state, caches, and session transcripts.
# Only settings.json, CLAUDE.md, and skills/ symlinks are tracked.
# plugins/ is ignored whole: it is a cache (marketplace git clones plus absolute
# installLocation and lastUpdated stamps Claude Code rewrites itself), and which
# plugins are wanted is declared by enabledPlugins in settings.json instead.
.claude/backups
.claude/cache
.claude/daemon
.claude/daemon.lock
.claude/daemon.log
.claude/daemon.status.json
.claude/file-history
.claude/history.jsonl
.claude/jobs
.claude/paste-cache
.claude/plugins
.claude/projects
.claude/session-env
.claude/sessions
.claude/shell-snapshots
.claude/.last-cleanup

# Repository validation fixtures are not home-directory dotfiles.
tests

# Generated Python bytecode is neither configuration nor a deployable tool.
**/__pycache__
**/*.pyc

# This Mac runs nvim-mentor, which other machines can't build (SSH clone,
# make and Go), so its plugin list and lockfile diverge from the shared ones.
{{ if eq .chezmoi.os "darwin" }}
.config/nvim/lua/plugins/init.lua
.config/nvim/nvim-pack-lock.json
{{ end }}
